# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env

# Create a key at https://openrouter.ai/keys (add ~$5 credit; that covers all pre-work)
OPENROUTER_API_KEY=sk-or-...

# Two models to compare in L02: one closed, one open-weight.
# Model ids change. If one is retired, pick a current one from https://openrouter.ai/models
MODEL_A=anthropic/claude-haiku-4.5
MODEL_B=meta-llama/llama-3.3-70b-instruct

# Model for the L03 agent. Must support tool calling. Defaults to MODEL_A if empty.
AGENT_MODEL=
